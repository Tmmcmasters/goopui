{
  "name": "@goopui/react",
  "version": "0.0.0",
  "private": true,
  "description": "goopUI components for React",
  "type": "module",
  "license": "MIT",
  "author": "Timothy McMasters",
  "homepage": "https://goop.timmcmasters.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tmmcmasters/goopui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Tmmcmasters/goopui/issues"
  },
  "keywords": [
    "goopui",
    "gooey",
    "ui",
    "components",
    "animation",
    "react"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@goopui/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
