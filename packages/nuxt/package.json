{
  "name": "@goopui/nuxt",
  "version": "0.1.0-alpha.0",
  "description": "Nuxt module for goopUI: auto-imports @goopui/vue components and their styles",
  "type": "module",
  "license": "MIT",
  "author": "Timothy McMasters",
  "homepage": "https://goop.timmcmasters.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tmmcmasters/goopui.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/Tmmcmasters/goopui/issues"
  },
  "keywords": [
    "goopui",
    "gooey",
    "ui",
    "components",
    "animation",
    "nuxt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "!**/._*"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepare": "nuxt-module-build build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@goopui/core": "workspace:*",
    "@goopui/vue": "workspace:*",
    "@nuxt/kit": "^4.6.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "nuxt": "^4.6.2",
    "typescript": "~5.9.3",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "nuxt": "^3.13.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
