{
  "name": "@goopui/core",
  "version": "0.0.0",
  "description": "Framework-agnostic engine for goopUI gooey, dripping UI elements",
  "type": "module",
  "license": "MIT",
  "author": "Timothy McMasters",
  "homepage": "https://goop.timmcmasters.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tmmcmasters/goopui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Tmmcmasters/goopui/issues"
  },
  "keywords": [
    "goopui",
    "gooey",
    "ui",
    "components",
    "animation",
    "physics"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo",
    "demo": "tsdown && node demo/serve.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
