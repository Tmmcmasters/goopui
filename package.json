{
  "name": "goopui-monorepo",
  "private": true,
  "description": "goopUI — interactive gooey, dripping UI elements for Vue, React, and Svelte",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:playground": "pnpm --filter playground dev",
    "dev:www": "pnpm --filter www dev",
    "dev:soon": "pnpm --filter soon dev",
    "generate:soon": "pnpm --filter soon generate",
    "promo:studio": "pnpm --filter @goopui/core build && pnpm --filter promo studio",
    "promo:render": "pnpm --filter @goopui/core build && pnpm --filter promo render",
    "promo:render:v7": "pnpm --filter @goopui/core build && pnpm --filter promo render:v7",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:dot": "bash scripts/clean-appledouble.sh",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:edge-clip": "node scripts/check-edge-clip.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "playwright-core": "1.59.1",
    "tsdown": "^0.23.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
