{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change: cache for a year, no revalidation round trips.
	# /_nuxt/builds/ (latest.json, the app manifest) is not hashed and must stay fresh.
	@hashed {
		path /_nuxt/*
		not path /_nuxt/builds/*
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# HTML, _payload.json, the content dump, images: revalidate (ETag) every time.
	@fresh not path /_nuxt/*
	header @fresh Cache-Control "no-cache"
	@builds path /_nuxt/builds/*
	header @builds Cache-Control "no-cache"

	# Pages are prerendered for their slash-less URL (/docs/components/sheet) but stored as
	# sheet/index.html. Plain file_server 308s /sheet to /sheet/, and the client router then
	# hydrates /sheet/, a different route than the HTML was rendered for (every active NuxtLink
	# and the docs title differ): "Hydration completed but contains mismatches". So send
	# /path/ to /path, and serve /path from path/index.html without a redirect (file_server
	# doesn't canonicalize a path that try_files rewrote to a different file name).
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1}{?query} 308
	try_files {path} {path}/index.html

	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
