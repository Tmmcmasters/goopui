{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change: cache for a year, no revalidation round trips.
	# /_nuxt/builds/ (latest.json, the app manifest) is not hashed and must stay fresh.
	@hashed {
		path /_nuxt/*
		not path /_nuxt/builds/*
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# HTML, _payload.json, the content dump, images: revalidate (ETag) every time.
	@fresh not path /_nuxt/*
	header @fresh Cache-Control "no-cache"
	@builds path /_nuxt/builds/*
	header @builds Cache-Control "no-cache"

	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
