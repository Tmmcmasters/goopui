{
  "name": "playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"for (const d of ['.nuxt','node_modules/.cache','node_modules/.vite']) require('fs').rmSync(d,{recursive:true,force:true})\" && nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "rm -rf .nuxt .output .turbo",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@goopui/core": "workspace:*",
    "@goopui/nuxt": "workspace:*",
    "@goopui/vue": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "nuxt": "^4.6.2",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.8.2",
    "shadcn-vue": "^2.8.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
